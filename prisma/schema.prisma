generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH MODELS ====================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==================== USER MODELS ====================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserTier {
  ROM
  CREATOR
  VERIFIED_CREATOR
}

enum CreatorType {
  SCIENTIST
  MANGAKA
  ARTIST
  WRITER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  username      String    @unique
  passwordHash  String?   @map("password_hash")
  displayName   String    @map("display_name")
  bio           String?   @db.Text
  avatarUrl     String?   @map("avatar_url")
  bannerUrl     String?   @map("banner_url")

  role     UserRole @default(USER)
  userTier UserTier @default(ROM) @map("user_tier")

  isVerified       Boolean  @default(false) @map("is_verified")
  verificationData Json?    @map("verification_data")
  creatorTypes     CreatorType[] @map("creator_types")

  // Denormalized counters for performance
  followerCount  Int @default(0) @map("follower_count")
  followingCount Int @default(0) @map("following_count")
  postCount      Int @default(0) @map("post_count")

  // Stripe integration (for future monetization)
  stripeCustomerId String? @unique @map("stripe_customer_id")
  stripeAccountId  String? @unique @map("stripe_account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts Account[]
  sessions Session[]
  posts    Post[]
  likes    Like[]
  bookmarks Bookmark[]
  reposts   Repost[]
  
  // Follow relations
  followers Follow[] @relation("Following")
  following Follow[] @relation("Follower")

  // Notifications
  notifications     Notification[] @relation("NotificationRecipient")
  actorNotifications Notification[] @relation("NotificationActor")

  // Media
  media Media[]

  // Manga series
  mangaSeries MangaSeries[]

  @@index([username])
  @@index([userTier])
  @@map("users")
}

// ==================== FOLLOW MODEL ====================

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ==================== POST MODELS ====================

enum PostType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  MANGA_CHAPTER
}

enum ContentRating {
  SFW
  NSFW
  NSFW_EXTREME
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  SUBSCRIBERS
  PRIVATE
}

model Post {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  parentId String?  @map("parent_id")

  postType      PostType      @default(TEXT) @map("post_type")
  content       String?       @db.Text
  contentRating ContentRating @default(SFW) @map("content_rating")
  visibility    PostVisibility @default(PUBLIC)

  // Scientific metadata (JSON for flexibility)
  scientificMetadata Json? @map("scientific_metadata")

  // Manga metadata
  mangaSeriesId String? @map("manga_series_id")
  chapterNumber Int?    @map("chapter_number")

  // Access control
  isPremiumOnly Boolean @default(false) @map("is_premium_only")

  // Denormalized counters for performance
  viewCount     Int @default(0) @map("view_count")
  likeCount     Int @default(0) @map("like_count")
  commentCount  Int @default(0) @map("comment_count")
  repostCount   Int @default(0) @map("repost_count")
  bookmarkCount Int @default(0) @map("bookmark_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Post? @relation("PostReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Post[] @relation("PostReplies")
  
  media     Media[]
  likes     Like[]
  bookmarks Bookmark[]
  reposts   Repost[]
  tags      PostTag[]
  
  mangaSeries MangaSeries? @relation(fields: [mangaSeriesId], references: [id])

  notifications Notification[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([postType])
  @@index([contentRating])
  @@index([mangaSeriesId])
  @@map("posts")
}

// ==================== MEDIA MODEL ====================

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  MANGA_PAGE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Media {
  id     String @id @default(cuid())
  postId String? @map("post_id")
  userId String @map("user_id")

  mediaType MediaType @map("media_type")

  // Storage info
  storageKey   String @map("storage_key")
  url          String
  thumbnailUrl String? @map("thumbnail_url")
  blurhash     String?

  // Metadata
  width           Int?
  height          Int?
  durationSeconds Int?   @map("duration_seconds")
  fileSize        BigInt @map("file_size")
  mimeType        String @map("mime_type")

  // Ordering for galleries
  orderIndex Int @default(0) @map("order_index")

  // Processing status
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
  @@map("media")
}

// ==================== SOCIAL MODELS ====================

model Like {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("bookmarks")
}

model Repost {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  originalPostId String   @map("original_post_id")
  quoteContent   String?  @db.Text @map("quote_content")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalPost Post @relation(fields: [originalPostId], references: [id], onDelete: Cascade)

  @@unique([userId, originalPostId])
  @@index([originalPostId])
  @@map("reposts")
}

// ==================== TAG MODELS ====================

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  category  String?
  postCount Int      @default(0) @map("post_count")
  createdAt DateTime @default(now()) @map("created_at")

  posts PostTag[]

  @@index([slug])
  @@map("tags")
}

model PostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ==================== MANGA MODELS ====================

enum MangaStatus {
  ONGOING
  COMPLETED
  HIATUS
  CANCELLED
}

model MangaSeries {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  title       String
  description String?     @db.Text
  coverUrl    String?     @map("cover_url")
  status      MangaStatus @default(ONGOING)
  genres      String[]
  
  chapterCount    Int @default(0) @map("chapter_count")
  subscriberCount Int @default(0) @map("subscriber_count")
  
  isPremium Boolean @default(false) @map("is_premium")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters Post[]

  @@index([userId])
  @@map("manga_series")
}

// ==================== NOTIFICATION MODEL ====================

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  REPOST
  MENTION
  SUBSCRIPTION
  TIP
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  actorId   String?          @map("actor_id")
  postId    String?          @map("post_id")
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post  Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("notifications")
}
